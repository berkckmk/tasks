rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // email_verified is required so a password-signup account can't touch
    // any user data until the owner actually clicks the link from
    // AuthRepository.signUpWithEmail's verification email — the anti-abuse
    // measure requested alongside this. Google accounts arrive with
    // email_verified already true (Google verifies it), so this never
    // blocks them. The corresponding Flutter-side gate is the /verify-email
    // redirect in app/router/app_router.dart, but that alone only hides
    // UI — this is what actually stops a signed-in-but-unverified account
    // from writing directly to Firestore with its own valid ID token.
    //
    // Because of this, the profile/subscription bootstrap for password
    // signups can't happen at signUp() time (the token doesn't carry
    // email_verified: true yet) — it's deferred to
    // AuthActions.checkEmailVerified(), which forces an ID token refresh
    // via User.getIdToken(true) right after confirming verification, so
    // the token Firestore sees is actually current.
    /**
     * Validates the notification half of `appPreferences`.
     *
     * These fields drive scheduled Cloud Functions, so a bad value is not a
     * cosmetic problem: an out-of-range `taskDigestHour` means the hourly
     * pass never matches that user's local hour and their digest silently
     * stops arriving, with nothing logged. The functions clamp defensively
     * too (functions/src/notifications/preferences.ts) — this stops the bad
     * value being stored in the first place.
     *
     * Each field is optional. None of them exist on a profile written before
     * the notification settings screen shipped, and absent means enabled on
     * both sides.
     */
    function hasValidNotificationPreferences(prefs) {
      return (!('notificationsEnabled' in prefs) || prefs.notificationsEnabled is bool)
        && (!('notifyHabitReminders' in prefs) || prefs.notifyHabitReminders is bool)
        && (!('notifyTaskDigest' in prefs) || prefs.notifyTaskDigest is bool)
        && (!('notifyReminderAlerts' in prefs) || prefs.notifyReminderAlerts is bool)
        && (!('taskDigestHour' in prefs) || (
          prefs.taskDigestHour is int
          && prefs.taskDigestHour >= 0
          && prefs.taskDigestHour <= 23
        ));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Closed-beta switch — mirrors `kBetaAllAccess` in
    // lib/features/subscription/domain/beta_access.dart and
    // `BETA_ALL_ACCESS` in functions/src/lib/plan.ts. While true, every
    // signed-in owner is treated as being on the `complete` plan. See the
    // Dart file for why this exists and for the full flip-list.
    //
    // Note this is checked *before* userPlan() below, and `||`
    // short-circuits, so during the beta these rules never issue the
    // subscription get() at all — no extra document read per write.
    function betaAllAccess() {
      return true;
    }

    // Server-side plan enforcement. Mirrors PlanEnforcement on the Flutter
    // side (features/subscription/domain/plan_enforcement.dart) — that
    // client-side check alone only hides UI, it doesn't stop a signed-in
    // user from writing directly to Firestore with their own valid
    // credentials (e.g. from the browser console). This get() is what
    // actually closes that gap for security-rule-enforced collections.
    //
    // This is only trustworthy because subscription/status is NOT
    // client-writable (see its match block below). When it was, this whole
    // check was circular — the account being gated could write the very
    // document that gates it.
    //
    // Fails closed at every step: a missing subscription doc (e.g. the brief
    // window right after sign-up) makes get() error and the surrounding
    // allow rule evaluate to false; a cancelled/expired subscription, or one
    // whose expiresAt has passed, resolves to no plan rather than the stale
    // paid one.
    // Every field is read with .get(key, default) rather than dot access:
    // a document written before these fields existed would otherwise make
    // the whole rule error out instead of evaluating.
    function subscriptionIsLive(sub) {
      return !(sub.get('status', 'active') in ['expired', 'canceled'])
        && (sub.get('expiresAt', null) == null || request.time < sub.expiresAt)
        && (sub.get('status', 'active') != 'trialing'
            || sub.get('trialEndsAt', null) == null
            || request.time < sub.trialEndsAt);
    }

    function planFromSubscription(sub) {
      return subscriptionIsLive(sub) ? sub.get('planId', 'starter') : 'starter';
    }

    // Note the single get(): `subscriptionIsLive` and the planId read both
    // work off one already-fetched snapshot, so a write costs at most one
    // extra document read (and none at all while the beta short-circuits).
    function userPlan(uid) {
      return planFromSubscription(
        get(/databases/$(database)/documents/users/$(uid)/subscription/status).data
      );
    }

    function hasPlanAtLeast(uid, plans) {
      return isOwner(uid) && (betaAllAccess() || userPlan(uid) in plans);
    }

    // users/{uid} — the profile document itself.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && isNonEmptyString(request.resource.data.email)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.selectedPlan in ['starter', 'growth', 'complete']
        && request.resource.data.onboardingCompleted is bool;

      allow update: if isOwner(uid)
        // Identity fields are immutable after creation.
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.selectedPlan in ['starter', 'growth', 'complete']
        && (
          !('appPreferences' in request.resource.data.keys())
          || hasValidNotificationPreferences(request.resource.data.appPreferences)
        );

      allow delete: if isOwner(uid);

      // habits/{habitId}
      //
      // `create` is Admin-SDK-only (the createHabit Cloud Function) — never
      // client-writable. Security rules have no way to count how many
      // habit docs already exist in this collection, so there's no rule
      // that could enforce the Starter plan's 3-habit limit here; the
      // function counts the real collection with an aggregation query
      // before writing. `update`/`delete` stay client-direct since neither
      // can increase the count.
      match /habits/{habitId} {
        allow read, delete: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.category in ['morning', 'evening', 'health', 'work'];
      }

      // habit_logs/{logId} — doc id is '{habitId}_{yyyy-MM-dd}'.
      match /habit_logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.habitId)
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.completed is bool;
      }

      // tasks/{taskId}
      //
      // `create` is Admin-SDK-only (the createTask Cloud Function) — same
      // reasoning as habits/{habitId} above, enforcing the Starter plan's
      // 20-active-task limit via an aggregation query rules can't express.
      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.priority in ['low', 'medium', 'high']
          && request.resource.data.status in ['todo', 'inProgress', 'done'];
      }

      // reminders/{reminderId} — the third core pillar alongside tasks and
      // habits. This collection previously had no match block at all, so the
      // default deny applied and every client read and write failed with
      // permission-denied while the feature looked finished in the UI.
      //
      // Creation stays client-direct rather than going through a Cloud
      // Function: unlike habits and tasks there is no per-plan count limit to
      // enforce here, so there is nothing rules can't express.
      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.status in ['scheduled', 'completed', 'snoozed', 'missed'];
      }

      // goals/{goalId} — goal planner requires Growth or above.
      match /goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['growth', 'complete'])
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.manualProgress is number
          && request.resource.data.manualProgress >= 0
          && request.resource.data.manualProgress <= 1;
      }

      // weekly_plans/{planId} — reserved for the weekly planner (not yet
      // built in the UI); same owner-only rule, no field validation yet.
      match /weekly_plans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // progress_snapshots/{snapshotId} — intended to be written by a
      // scheduled Cloud Function (Admin SDK bypasses these rules), not the
      // client, so a user can't fabricate their own progress numbers.
      match /progress_snapshots/{snapshotId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // settings/app — single document with app-level preferences that
      // aren't part of the core profile doc.
      match /settings/{settingsDoc} {
        allow read, write: if isOwner(uid);
      }

      // subscription/status — the entitlement document read by
      // userPlan() above and by getUserPlanId() in the Cloud Functions.
      //
      // Upgrades are Admin-SDK-only: only handleBillingWebhook (verified
      // against Stripe's signature) and verifyPlayPurchase (verified against
      // the Play Developer API) may change the plan. If the client could
      // write this, every plan check in this file and in functions/ would be
      // circular — the account being gated writing the document that gates
      // it — and any user could grant themselves Complete for free with one
      // console write. That was previously the case; it is the single most
      // important thing on this file not to regress.
      //
      // `create` stays open but is pinned to a free starter document so the
      // sign-up bootstrap (AuthActions._bootstrapProfileIfNeeded ->
      // FirestoreSubscriptionRepository.createInitialStatus) still works
      // without a Cloud Function round-trip. It grants nothing: `update` and
      // `delete` are both denied, so the doc can't be escalated afterwards
      // and can't be deleted and re-created to reset it either.
      //
      // Free access during the closed beta is granted by betaAllAccess()
      // above, deliberately NOT by writing 'complete' here — that keeps the
      // grant in one auditable place instead of scattered across every
      // tester's user document.
      match /subscription/{statusDoc} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.planId == 'starter'
          && request.resource.data.billingProvider is string;
        allow update, delete: if false;
      }

      // finance_transactions/{transactionId} — Complete plan only. Reads
      // stay owner-only (so a downgraded user can still see/export old
      // data) but new writes require an active Complete plan.
      match /finance_transactions/{transactionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
      }

      // savings_goals/{goalId} — Complete plan only.
      match /savings_goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0;
      }

      // workouts/{workoutId} — Complete plan only.
      match /workouts/{workoutId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && isNonEmptyString(request.resource.data.name);
      }

      // exercise_logs/{logId} — Complete plan only.
      match /exercise_logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && isNonEmptyString(request.resource.data.workoutId)
          && isNonEmptyString(request.resource.data.name);
      }

      // learning_items/{itemId} — Complete plan only.
      match /learning_items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.type in ['book', 'course', 'podcast']
          && request.resource.data.status in ['planned', 'inProgress', 'completed'];
      }

      // content_items/{itemId} — Complete plan only.
      match /content_items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if hasPlanAtLeast(uid, ['complete'])
          && isNonEmptyString(request.resource.data.title)
          && request.resource.data.status in ['idea', 'drafted', 'scheduled', 'published'];
      }

      // integrations/{google_calendar|google_sheets|google_drive|google_docs}
      //
      // Client-writable ONLY for reads. Every field (enabled, status,
      // spreadsheetId, folderUrl, lastSyncedAt, ...) is written by a Cloud
      // Function after a real OAuth exchange or Google API call — never
      // directly by the client. This is what makes "connected" trustworthy:
      // a user can't fake connecting Google Sheets by just writing the doc.
      match /integrations/{integrationId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // secureTokens/{integrationId} — Google OAuth refresh tokens. NEVER
      // client-accessible, in either direction. Only the Admin SDK (Cloud
      // Functions) can read or write this collection.
      match /secureTokens/{integrationId} {
        allow read, write: if false;
      }

      // reports/{reportId} — generated by generateGoogleDocsReport.
      // Read-only from the client so a user can see their own reports but
      // can't fabricate a "ready" report pointing at an arbitrary Doc.
      match /reports/{reportId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // fcmTokens/{token} — doc id is the push token itself, written
      // directly by the client that owns the device (see
      // PushNotificationsRepository). Unlike secureTokens, an FCM token
      // isn't a credential for the user's Google account — worst case a
      // leaked one lets someone push a notification to that one device, not
      // access any user data — so client-write is an acceptable trade-off
      // for not needing a Cloud Function round-trip just to register a
      // device.
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.token == token;
      }
    }
  }
}
