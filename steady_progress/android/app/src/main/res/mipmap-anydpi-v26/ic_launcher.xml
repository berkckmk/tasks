<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon (API 26+).

    Three layers, and the monochrome one is the same ring: because the mark is
    nothing but a stroke, Android 13's themed icons can recolour it without
    anything to go wrong — no letter to lose contrast, no gradient to flatten,
    no glyph to fill in.

    Below API 26 the launcher falls back to the raster mipmap-*/ic_launcher.png
    files. API 26+ uses the same supplied bitmap as the foreground layer so the
    launcher icon does not drift from the app-store/iOS artwork.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
