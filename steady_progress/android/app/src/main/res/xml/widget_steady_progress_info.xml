<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is 0 on purpose: the platform floors periodic widget
    updates at 30 minutes and wakes the device to deliver them, which would
    cost battery to redraw numbers that haven't changed. The widget is instead
    pushed from the app whenever the data actually changes (see
    HomeWidgetService on the Flutter side), and the clock in the header is a
    TextClock, which ticks itself.

    previewLayout points at the real layout now. It used to need a static
    stand-in, because the real one was a single ImageView that stayed empty
    until a provider run pushed a bitmap into it and the picker inflates a
    layout without ever running the provider — so it showed an empty
    rectangle. The rebuilt layout has real views with real defaults, so the
    picker renders a recognisable panel on its own.

    Sizes match the design: 2x2 is 166x158, 4x2 is 348x158 (the default),
    4x4 is 348x340. minResize allows 2x2; maxResize allows 4x4.

    widgetFeatures (API 31+):
      reconfigurable         - adds the launcher's "configure" affordance on
                               long-press, so the setup can be changed after
                               placement, not only when first dropped.
      configuration_optional - the widget is placed with sensible defaults if
                               the user dismisses setup, instead of silently
                               refusing to be added.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="348dp"
    android:minHeight="158dp"
    android:minResizeWidth="166dp"
    android:minResizeHeight="158dp"
    android:maxResizeWidth="348dp"
    android:maxResizeHeight="340dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_steady_progress"
    android:previewLayout="@layout/widget_steady_progress"
    android:description="@string/widget_description"
    android:configure="com.steadyprogress.steady_progress.widget.SteadyProgressWidgetConfigureActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:updatePeriodMillis="0" />
