<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-add text field. A filled well rather than the platform's
     underline: the panel is already a surface, and an underline on it reads
     as a divider. Radius 12, one step tighter than the panel's 16. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/nocturne_ink" />
    <stroke
        android:width="1dp"
        android:color="@color/nocturne_divider" />
</shape>
