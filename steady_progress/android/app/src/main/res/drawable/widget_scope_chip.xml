<?xml version="1.0" encoding="utf-8"?>
<!--
    The header chip — "TODAY ⌄".

    Radius 10 (a deliberate exception to Nocturne's 4/8/14 scale, listed as
    such in the handoff) and a 1dp accent-40% border. No fill: the accent is a
    line and a mark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/nocturne_accent_40" />
</shape>
