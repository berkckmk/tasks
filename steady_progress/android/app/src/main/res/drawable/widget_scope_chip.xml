<?xml version="1.0" encoding="utf-8"?>
<!--
    The header chip — "TODAY ⌄".

    Radius 10 (a deliberate exception to Nocturne's 4/8/14 scale, listed as
    such in the handoff) and a white outline with a quiet outer halo. No fill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#EAEAEA" />
        </shape>
    </item>
</layer-list>
