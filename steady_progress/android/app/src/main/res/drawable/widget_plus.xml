<?xml version="1.0" encoding="utf-8"?>
<!-- A Phosphor-style plus icon for the widget quick-add button.
     24×24 viewport, white stroke plus a controlled outer halo. Kept as a vector
     drawable rather than a font glyph because RemoteViews' ImageView
     can tint and scale a drawable but cannot render a font icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:pathData="M12,5L12,19M5,12L19,12"
        android:strokeWidth="4"
        android:strokeColor="#40FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,5L12,19M5,12L19,12"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
</vector>
