<?xml version="1.0" encoding="utf-8"?>
<!--
    The checked toggle: Phosphor `check-circle`, **Fill**.

    A solid disc with the check *knocked out* rather than drawn on top — one
    path, `evenOdd`, so the check is transparent and whatever the panel's
    configurable ground happens to be shows through it. Drawing the check as a
    second filled path would need to know that ground, and the ground is a
    user setting.

    White for the same reason as widget_circle: the provider tints it with a
    SRC_ATOP colour filter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2.4,12 A9.6,9.6 0 1 1 21.6,12 A9.6,9.6 0 1 1 2.4,12 Z M6.4,13.1 L10.4,17.1 L17.6,9.9 L16.2,8.5 L10.4,14.3 L7.8,11.7 Z" />
</vector>
