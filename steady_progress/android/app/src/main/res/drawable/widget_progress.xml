<?xml version="1.0" encoding="utf-8"?>
<!--
    The 3px determinate bar under the header.

    A layer-list rather than the platform ProgressBar drawable: the default
    carries a rounded inset, a secondary track and a theme tint. Track is
    passive grey; the filled part is pure white.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#555555" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
