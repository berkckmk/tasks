# Copy to `.env` (never commit the real .env) or set via
# `firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET` for production.
#
# From Google Cloud Console > APIs & Services > Credentials, the "Web
# application" OAuth client used for server-side token exchange (see
# lib/core/google/google_auth_config.dart's serverClientId on the Flutter
# side — this must be the SAME client).
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_SERVER_OAUTH_CLIENT_ID.apps.googleusercontent.com

# The client secret for that OAuth client. This is the whole reason token
# exchange happens here and not on-device: this value must never ship in
# the Flutter app.
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# --- Stripe (Web billing) ---
# Dashboard > Developers > API keys. Use a *restricted* key in production
# if possible, not the full secret key.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret.
# The endpoint URL to register there is the deployed handleBillingWebhook
# function's URL.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
# Dashboard > Product catalog > Prices — must match
# lib/features/subscription/domain/billing_product_ids.dart's
# stripePriceIds.
STRIPE_PRICE_GROWTH=REPLACE_WITH_GROWTH_PRICE_ID
STRIPE_PRICE_COMPLETE=REPLACE_WITH_COMPLETE_PRICE_ID

# --- Google Play Billing (Android) ---
# Must match android/app/build.gradle.kts's applicationId.
ANDROID_PACKAGE_NAME=com.example.steady_progress
