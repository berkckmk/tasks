<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration screen for a placed widget. Plain framework views, no
    AppCompat / Material dependency: this activity is launched by the
    launcher, often with the app not running, and it exists to draw five
    checkboxes and a preview.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/config_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/config_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/config_subtitle"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/config_text_muted" />

            <!-- Live preview, drawn by the same renderer the home screen
                 uses. The checkerboard behind it stands in for a wallpaper so
                 the panel's translucency is visible here too. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/config_preview_backdrop"
                android:padding="14dp">

                <!-- The user's wallpaper, when they've chosen one. Sits
                     behind the preview so the panel is judged against the
                     thing it will actually refract, not against a
                     checkerboard. Hidden until an image is picked. -->
                <ImageView
                    android:id="@+id/config_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@string/config_wallpaper_description" />

                <ImageView
                    android:id="@+id/config_preview"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:adjustViewBounds="false"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/config_preview_description" />
            </FrameLayout>

            <TextView
                android:id="@+id/config_drag_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/config_drag_hint"
                android:textSize="12sp"
                android:visibility="gone"
                android:textColor="@color/config_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/config_wallpaper_heading"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.09"
                android:textAllCaps="true"
                android:textColor="@color/config_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/config_wallpaper_description"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/config_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/config_wallpaper_pick"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_wallpaper_pick"
                    android:textColor="@color/config_accent" />

                <Button
                    android:id="@+id/config_wallpaper_clear"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/config_wallpaper_clear"
                    android:textColor="@color/config_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/config_backdrop_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/config_fields_heading"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.09"
                android:textAllCaps="true"
                android:textColor="@color/config_accent" />

            <LinearLayout
                android:id="@+id/config_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/config_appearance_heading"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.09"
                android:textAllCaps="true"
                android:textColor="@color/config_accent" />

            <LinearLayout
                android:id="@+id/config_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:background="@color/config_bar"
        android:padding="14dp">

        <Button
            android:id="@+id/config_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_cancel"
            android:textColor="@color/config_text_muted" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/config_save"
            android:textColor="@color/config_on_accent"
            android:background="@drawable/config_button" />
    </LinearLayout>
</LinearLayout>
