<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable field. The row is the touch target; the checkbox is
     toggled by the row's click listener rather than being tapped directly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/row_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/config_text"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/row_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="-2dp"
        android:textSize="13sp"
        android:textColor="@color/config_text_muted" />
</LinearLayout>
