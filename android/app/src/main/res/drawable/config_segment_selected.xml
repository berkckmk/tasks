<?xml version="1.0" encoding="utf-8"?>
<!--
    The selected option in a segmented control: an inset 1dp accent ring.

    It carries the container's own 8dp radius rather than square corners. That
    is not cosmetic — a square ring painted inside a rounded box shows two
    mismatched corners at each end of the control, which is exactly the bug
    the handoff calls out.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/config_accent" />
</shape>
