<?xml version="1.0" encoding="utf-8"?>
<!-- The segmented control's container. The selected option draws its own
     inset accent ring inside this; see config_segment_selected.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@color/config_divider" />
</shape>
