<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in for a wallpaper behind the preview. The panel is genuinely
     translucent, so previewing it on a flat surface would hide the one
     property that makes it glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/config_preview_backdrop_a"
        android:endColor="@color/config_preview_backdrop_b"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
