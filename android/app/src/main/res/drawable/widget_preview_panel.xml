<?xml version="1.0" encoding="utf-8"?>
<!-- Approximates the glass card in the picker: translucent fill, hairline
     rim, generous corner radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_fill" />
    <stroke android:width="1dp" android:color="@color/widget_preview_rim" />
    <corners android:radius="26dp" />
</shape>
