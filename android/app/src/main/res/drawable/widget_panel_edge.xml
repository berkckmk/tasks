<?xml version="1.0" encoding="utf-8"?>
<!--
    The panel's single hairline edge. 22dp corners, 1dp stroke, no fill.

    **One physical pixel at every size**, which is what the One UI luminance
    profiling was chasing — reached by not drawing a glow, a rim highlight or
    a bitmap at all, just a stroke.

    Drawn on its own view above the fill so it never fades with the opacity
    slider. See widget_panel_fill.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/nocturne_divider" />
</shape>
