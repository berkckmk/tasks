<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark variants of values/colors.xml.

    Only the `config_*` tokens appear here. The `nocturne_*` tokens are
    deliberately absent: they are the widget's own surface colours, and a
    widget sits on the user's wallpaper with no app ground behind it — there
    is nothing for it to follow. Flipping the panel to a light slab because
    the phone is in light mode would put light-on-light on half the
    wallpapers out there.
-->
<resources>
    <color name="config_background">#161826</color>
    <color name="config_bar">#232532</color>
    <color name="config_text">#E9E9ED</color>
    <color name="config_text_muted">#94E9E9ED</color>
    <color name="config_accent">#9184D9</color>
    <color name="config_on_accent">#161826</color>
    <color name="config_divider">#29E9E9ED</color>
    <color name="config_preview_backdrop_a">#3F424D</color>
    <color name="config_preview_backdrop_b">#292B31</color>
    <!-- Unfilled part of a slider track. -->
    <color name="config_track">#29E9E9ED</color>
</resources>
