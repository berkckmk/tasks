<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown in the launcher's widget picker, and as the widget's
         accessibility label. -->
    <string name="widget_name">Today</string>
    <string name="widget_description">Your reminders, tasks and habits for today — tick them off without opening the app.</string>

    <!-- The header chip. Uppercased and set at build time by the provider;
         this is the value the layout inflates with so the picker preview and
         the first frame aren't blank. -->
    <string name="widget_scope_today">TODAY ⌄</string>

    <!-- Row accessibility. The toggle is a 15dp glyph, so its own name is the
         only thing a screen reader has to go on. -->
    <string name="widget_row_toggle">Toggle</string>
    <string name="widget_row_toggle_open">Mark %1$s as done</string>
    <string name="widget_row_toggle_done">Mark %1$s as not done</string>

    <!-- Empty state. Two messages: one for "the app has never synced", one for
         "it synced and there is genuinely nothing left". Never zeros
         presented as data. -->
    <string name="widget_empty_title">Nothing scheduled</string>
    <string name="widget_empty_message">Open Steady Progress to sync</string>
    <string name="widget_empty_message_synced">You\'re all caught up</string>

    <!-- 4x4 footer. -->
    <string name="widget_footer_more">+%1$d later this week</string>
    <string name="widget_footer_action">Remind me</string>

    <!-- ===== Widget setup screen ===== -->
    <string name="config_title">Widget setup</string>
    <string name="config_preview_description">Live preview of the widget with the settings you have chosen.</string>
    <string name="config_preview_summary">5 / 12 · 42 day streak</string>

    <string name="config_background_label">Background</string>
    <string name="config_background_description">The panel\'s ground. Pick None to let the rows sit straight on your wallpaper.</string>

    <string name="config_opacity_label">Opacity</string>
    <!-- Says exactly what the slider does and does not touch, because the
         obvious reading — "this fades the widget" — is wrong. -->
    <string name="config_opacity_description">Only the panel fades. Text, the progress bar and the icons keep their own colours, so this stays readable at every setting.</string>
    <string name="config_percent">%1$d%%</string>

    <string name="config_rows_label">Rows shown</string>

    <string name="config_include_label">Include</string>
    <string name="config_include_description">Which of your three lists a Today widget draws from. A widget scoped to Reminders or Tasks ignores this.</string>

    <string name="config_save">Add widget</string>
    <string name="config_cancel">Cancel</string>

    <!-- Ground names. -->
    <string name="config_ground_surface">Surface</string>
    <string name="config_ground_ink">Ink</string>
    <string name="config_ground_accent">Accent</string>
    <string name="config_ground_none">None</string>
</resources>
