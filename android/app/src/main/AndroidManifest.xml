<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared explicitly rather than relying on manifest merging from
         firebase_messaging. The release build only had network access because
         that plugin happened to contribute INTERNET; dropping or replacing FCM
         would have removed it with no compile-time error. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Requested at runtime by PushNotificationsRepository.requestPermission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Steady Progress"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Home-screen widget. Not exported: it's driven by the system
             AppWidgetManager broadcast below and by in-process refreshes from
             the app, so nothing outside the app needs to reach it.

             android:label is what the launcher's widget picker shows as the
             widget's name. Without it the widget inherits the application
             label and the picker reads "Steady Progress / Steady Progress". -->
        <receiver
            android:name=".widget.SteadyProgressWidgetProvider"
            android:label="@string/widget_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Where the collection's fill-in intents land: a row tap and
                     a toggle tap both arrive here through the list's single
                     PendingIntent template. -->
                <action android:name="com.steadyprogress.ACTION_WIDGET_ROW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steady_progress_info" />
        </receiver>


        <!-- Setup screen for a placed widget. Exported because the
             *launcher* starts it — both when the widget is first dropped and
             from the long-press "configure" affordance — and the launcher is
             a different app. It acts only on the appWidgetId it is handed. -->
        <activity
            android:name=".widget.SteadyProgressWidgetConfigureActivity"
            android:label="@string/config_title"
            android:theme="@style/WidgetConfigureTheme"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The scope picker: Today / Reminders / Tasks.

             RemoteViews has no popup and no Spinner, so the widget's header
             chip fires a PendingIntent into this transparent, no-title
             Activity instead. Not exported: only the widget's own
             PendingIntent starts it, and that is created in-process.

             excludeFromRecents + noHistory because it is a menu, not a
             screen — it should never appear in the recents switcher and
             should not survive being backgrounded. -->
        <activity
            android:name=".widget.WidgetScopePickerActivity"
            android:theme="@style/WidgetScopePickerTheme"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!-- Feeds the widget's scrolling rows.

             BIND_REMOTEVIEWS is a signature-level permission held by the
             system: requiring it here means only the platform's
             AppWidgetService can bind this, not another app. Every widget
             collection service must declare it. -->
        <service
            android:name=".widget.WidgetItemsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
