<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/add_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@drawable/widget_picker_panel"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Top Header: Title and Type selector chips -->
        <TextView
            android:id="@+id/add_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:textSize="18.5sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/stone_text"
            android:text="@string/widget_add_title" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/add_kinds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:background="@color/stone_divider" />

        <!-- Scrollable Form Body -->
        <ScrollView
            android:id="@+id/add_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title / Name Input -->
                <EditText
                    android:id="@+id/add_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="6dp"
                    android:background="@null"
                    android:textSize="16.5sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/stone_text"
                    android:textColorHint="@color/stone_text_caption"
                    android:hint="@string/widget_add_hint"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"
                    android:maxLines="1"
                    android:importantForAutofill="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stone_divider" />

                <!-- Description / Note Input (Task & Reminder) -->
                <LinearLayout
                    android:id="@+id/add_description_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/add_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@null"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/stone_text"
                        android:textColorHint="@color/stone_text_caption"
                        android:hint="@string/widget_add_desc_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="3"
                        android:importantForAutofill="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />
                </LinearLayout>

                <!-- When / Schedule Row -->
                <LinearLayout
                    android:id="@+id/add_when_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:id="@+id/add_when_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/widget_calendar"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/add_when_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:textSize="15sp"
                        android:textColor="@color/stone_text_muted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/widget_add_when_empty" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stone_divider" />

                <!-- ===== TASK SPECIFIC CONTROLS ===== -->
                <LinearLayout
                    android:id="@+id/section_task_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Priority -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_priority_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <LinearLayout
                            android:id="@+id/task_priority_chips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />

                    <!-- Recurrence -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_repeat_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/task_repeat_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />
                </LinearLayout>

                <!-- ===== REMINDER SPECIFIC CONTROLS ===== -->
                <LinearLayout
                    android:id="@+id/section_reminder_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Recurrence -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_repeat_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/reminder_repeat_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />

                    <!-- Important / Audible Alarm Toggle -->
                    <LinearLayout
                        android:id="@+id/reminder_important_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/widget_important_title"
                                android:textSize="14sp"
                                android:fontFamily="@font/inter_semibold"
                                android:textColor="@color/stone_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/widget_important_subtitle"
                                android:textSize="12sp"
                                android:textColor="@color/stone_text_caption" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/add_important_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />
                </LinearLayout>

                <!-- ===== HABIT SPECIFIC CONTROLS ===== -->
                <LinearLayout
                    android:id="@+id/section_habit_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Category -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_habit_category_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/habit_category_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />

                    <!-- Frequency -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_habit_frequency_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/habit_frequency_chips"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />

                    <!-- Color Picker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/widget_habit_color_label"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/stone_text_caption" />

                        <LinearLayout
                            android:id="@+id/habit_color_dots"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stone_divider" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Action Buttons: Cancel and Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/add_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="15sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/stone_text_muted"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/widget_add_cancel" />

            <TextView
                android:id="@+id/add_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_add_confirm"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="15sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/stone_on_accent"
                android:text="@string/widget_add_confirm" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
