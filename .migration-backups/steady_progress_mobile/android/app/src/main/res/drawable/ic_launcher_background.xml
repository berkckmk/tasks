<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon's background layer: the flat ink ground, `#1b1d2b`.

    Flat on purpose. A launcher may scale, mask and parallax this layer
    independently of the foreground; a gradient would shear against the ring
    as the user scrolls, and a texture would alias at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#1B1D2B" />
</vector>
