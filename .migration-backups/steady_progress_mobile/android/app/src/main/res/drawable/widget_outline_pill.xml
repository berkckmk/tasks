<?xml version="1.0" encoding="utf-8"?>
<!--
    The 4x4 footer's "Remind me" pill. Outlined, never filled — the system's
    strongest rule, and the reason this is a stroke with a transparent solid.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/stone_surface_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/stone_divider" />
</shape>
